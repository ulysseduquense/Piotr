{
  "name": "piotr",
  "version": "1.0.0",
  "private": true,
  "description": "Réservation de créneaux pour petits travaux, suivi des heures et des achats",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply piotr --local",
    "db:migrate": "wrangler d1 migrations apply piotr --remote"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "wrangler": "^4.160.0"
  }
}
