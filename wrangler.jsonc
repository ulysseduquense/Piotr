{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piotr",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Fichiers statiques (public/) servis directement ; seules les routes /api/* passent par le Worker.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "piotr",
      "database_id": "4200c2c4-8d68-41fc-9681-ad1e7c6b7cbf",
      "migrations_dir": "migrations"
    }
  ],
  // Photos des interventions : fichiers stockés dans R2 (npx wrangler r2 bucket create piotr-photos).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "piotr-photos" }],
  // Si renseigné, seul ce compte devient administrateur ; sinon le premier compte créé.
  "vars": { "ADMIN_EMAIL": "" }
}
